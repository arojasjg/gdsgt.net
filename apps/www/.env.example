# Google tag: GA4 measurement ID and/or Google Ads ID, comma-separated
NEXT_PUBLIC_GOOGLE_TAG_IDS=G-XXXXXXXXXX,AW-XXXXXXXXXX
# Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Optional site verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Lead delivery (/api/leads). Configure at least one; otherwise forms fall back to WhatsApp.
# Webhook: Google Apps Script (Sheets), Make, Zapier, n8n or your CRM
LEADS_WEBHOOK_URL=
# Email via Resend (resend.com)
RESEND_API_KEY=
LEADS_EMAIL_TO=ventas@gdsgt.net
LEADS_EMAIL_FROM=GDS Web <web@gdsgt.net>
