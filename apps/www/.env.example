# Google tag: GA4 measurement ID and/or Google Ads ID, comma-separated
NEXT_PUBLIC_GOOGLE_TAG_IDS=G-XXXXXXXXXX,AW-XXXXXXXXXX
# Meta (Facebook/Instagram) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Optional site verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Lead delivery (/api/leads). Configure at least one; otherwise forms fall back to WhatsApp.
# Email recipients (comma-separated)
LEADS_EMAIL_TO=info@gdsgt.net
LEADS_EMAIL_FROM=GDS Web <info@gdsgt.net>
# Option 1: SMTP (e.g. the Plesk mail server for gdsgt.net)
SMTP_HOST=mail.gdsgt.net
SMTP_PORT=465
SMTP_USER=info@gdsgt.net
SMTP_PASS=
# Option 2: Resend (resend.com) instead of SMTP
RESEND_API_KEY=
# GDS ONE ERP → CRM (Web_leadController in arojasjg/erp). Same secret as WEB_LEADS_TOKEN in the ERP.
GDSONE_LEADS_URL=https://www.gdsgt.net/erp/web_lead/recibir
GDSONE_API_KEY=
# Generic webhook: Google Apps Script (Sheets), Make, Zapier, n8n
LEADS_WEBHOOK_URL=
